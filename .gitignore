# =============================================================================
# .gitignore — Ensemble ML Fraud Detection
# =============================================================================

# ── Dataset (too large / proprietary — download from Kaggle) ─────────────────
data/creditcard.csv
data/*.csv

# ── Generated artefacts ───────────────────────────────────────────────────────
artifacts/*.pkl
artifacts/*.joblib
artifacts/*.model
results/metrics.json
figures/*.png
figures/*.pdf

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.env

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dashboard/frontend/dist/
dashboard/frontend/.env
dashboard/frontend/.env.*
frontend.log

# ── Build artefacts ───────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
frontend.log
